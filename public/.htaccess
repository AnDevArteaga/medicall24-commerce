# Medicall24 — HostGator / Apache / LiteSpeed

# MIME types correctos para módulos ES
AddType application/javascript .js .mjs
AddType text/css .css
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  # Evita fallos de type="module" con atributo crossorigin
  Header set Access-Control-Allow-Origin "*"
  # No cachear index.html (fuerza a cargar JS nuevo tras cada deploy)
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Assets con hash sí pueden cachearse
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# SPA: todas las rutas → index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
